#!/usr/bin/env bash
# ==============================================================================
# Agent Skills Repository - Intelligent Pre-Push Gate
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

if [ -t 1 ]; then
    BOLD="\033[1m"
    DIM="\033[2m"
    RED="\033[1;31m"
    GREEN="\033[1;32m"
    YELLOW="\033[1;33m"
    BLUE="\033[1;34m"
    MAGENTA="\033[1;35m"
    CYAN="\033[1;36m"
    RESET="\033[0m"
else
    BOLD=""
    DIM=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    MAGENTA=""
    CYAN=""
    RESET=""
fi

START_TIME=$(date +%s)
FAILED_STEPS=()
PASSED_STEPS=()

print_banner() {
    echo -e "${CYAN}======================================================================${RESET}"
    echo -e "${BOLD}${MAGENTA}  Agent Skills Repository - Pre-Push Validation Gate${RESET}"
    echo -e "${CYAN}======================================================================${RESET}"
}

log_info() { echo -e "${BLUE}[INFO]${RESET} $*"; }
log_step() { echo -e "\n${BOLD}${CYAN}> [STEP]${RESET} ${BOLD}$*${RESET}"; }
log_pass() { echo -e "${GREEN}[PASS]${RESET} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${RESET} $*"; }
log_fail() { echo -e "${RED}[FAIL]${RESET} $*"; }

if [ "${SKIP_HOOKS:-0}" = "1" ] || [ "${PREPUSH_BYPASS:-0}" = "1" ]; then
    log_warn "Pre-push validations bypassed via SKIP_HOOKS=1 or PREPUSH_BYPASS=1."
    exit 0
fi

print_banner
log_info "Running pre-push verification checks..."

run_step() {
    local step_name="$1"
    local cmd="$2"
    local remediation="$3"

    log_step "${step_name}"
    local step_start
    step_start=$(date +%s)

    if ( cd "${REPO_ROOT}" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX && eval "${cmd}" ); then
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_pass "${step_name} (${elapsed}s)"
        PASSED_STEPS+=("${step_name}")
    else
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        log_fail "${step_name} failed after ${elapsed}s"
        FAILED_STEPS+=("${step_name}")
        echo -e "\n${RED}${BOLD}Push Aborted!${RESET} The step '${step_name}' did not pass."
        if [ -n "${remediation}" ]; then
            echo -e "${YELLOW}Suggested fix:${RESET} ${remediation}"
        fi
        exit 1
    fi
}

run_step "Skill Validator Script" "python3 scripts/validate-skills.py" "Fix schema or frontmatter issues in SKILL.md files."
run_step "Skills CLI Sync Validate" "./scripts/skills-sync.sh validate" "Fix formatting or schema issues in skills."
run_step "Scope & Taxonomy Unit Tests" "python3 -m unittest discover -s tests -v" "Ensure all unit tests pass before pushing."

END_TIME=$(date +%s)
TOTAL_TIME=$((END_TIME - START_TIME))

echo -e "\n${CYAN}======================================================================${RESET}"
echo -e "${GREEN}${BOLD}[PASS] All Pre-Push Validations Passed Successfully! (${TOTAL_TIME}s)${RESET}"
echo -e "${CYAN}======================================================================${RESET}\n"
exit 0
